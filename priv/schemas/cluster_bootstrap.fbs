// Bootstrap info stored in object storage
namespace Bedrock.SystemKeys;

table OtpRef {
  otp_name: string;
  node: string;
}

table LogInfo {
  id: string;
  otp_ref: OtpRef;
  shard_tags: [uint];  // Which shards this log serves
}

table CoordinatorInfo {
  node: string;
}

// The system shard's materializer members. This is the record that says
// WHERE the cluster's metadata lives: the shard layout and the
// materializers family are both served from tag 0, so recovery cannot
// read either until it knows which workers hold it. FDB records the
// equivalent out of band too — its coordinated state names the tlogs
// that hold the txnStateStore.
table MaterializerInfo {
  id: string;
  node: string;
}

// Cluster configuration parameters
table ClusterParameters {
  desired_logs: uint;
  desired_replication_factor: uint;
  desired_commit_proxies: uint;
  desired_coordinators: uint;
  desired_read_version_proxies: uint;
  ping_rate_in_hz: uint;
  retransmission_rate_in_hz: uint;
  transaction_window_in_ms: uint;
  empty_transaction_timeout_ms: uint;
  // Read-inactivity window after which a data-shard materializer spins
  // itself down (bedrock-q67.21.8). Zero disables spin-down, and the
  // non-zero schema default is what makes that representable: a scalar
  // equal to its default is not written, so with the implicit default
  // of 0 a disabled cluster would read back as "absent" and silently
  // re-enable. Absent still means absent — a record written before this
  // field existed — and reads back as the Parameters default. Keep this
  // value equal to that default: a cluster explicitly configured AT the
  // schema default writes nothing and reads back absent, so if the two
  // drift, such a cluster silently migrates to the other one.
  materializer_idle_timeout_ms: uint = 900000;
}

// Cluster policies
table ClusterPolicies {
  allow_volunteer_nodes_to_join: bool;
}

table ClusterBootstrap {
  cluster_id: string;
  epoch: ulong;
  logs: [LogInfo];
  coordinators: [CoordinatorInfo];
  parameters: ClusterParameters;
  policies: ClusterPolicies;
  system_materializers: [MaterializerInfo];
}

root_type ClusterBootstrap;
